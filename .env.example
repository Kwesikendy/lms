# ============================================================================
# AETHER LMS — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and supply real credentials for external services.
# NEVER commit real secrets to source control.
# ============================================================================

# Server & Application
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001

# Security & Session Signing (Generate a random 64-byte hex string in production)
SESSION_SECRET=replace_with_64_byte_cryptographic_secret_in_production
MEDIA_SIGNING_SECRET=replace_with_media_url_hmac_secret_in_production

# Database Configuration
# Local development defaults to SQLite at ./data/lms.sqlite.
# For PostgreSQL in production, set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/aether_lms
SQLITE_DB_PATH=./data/lms.sqlite

# LiveKit Configuration (Required for real WebRTC media routing & Egress recording)
# Obtain from LiveKit Cloud (https://cloud.livekit.io) or self-hosted LiveKit server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_placeholder
LIVEKIT_API_SECRET=your_livekit_api_secret_placeholder
LIVEKIT_EGRESS_ENABLED=false

# Payment Providers (Ghana Mobile Money & Card Payments)
# Primary Provider: Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_placeholder
PAYSTACK_WEBHOOK_SECRET=sk_test_your_paystack_secret_key_placeholder

# Secondary Provider: Hubtel (https://hubtel.com)
HUBTEL_CLIENT_ID=your_hubtel_client_id_placeholder
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_placeholder
HUBTEL_MERCHANT_ACCOUNT=your_hubtel_merchant_number_placeholder
HUBTEL_WEBHOOK_SECRET=your_hubtel_webhook_hmac_secret_placeholder

# Storage Provider (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=your-private-lms-bucket
S3_REGION=eu-west-1
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_ACCESS_KEY_ID=your_s3_access_key_placeholder
S3_SECRET_ACCESS_KEY=your_s3_secret_key_placeholder
