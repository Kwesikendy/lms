{
  "name": "aether-lms",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Glassmorphism Learning Management System with LiveKit Classroom & Ghana-first Payments",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "build": "npm run build:api && vite build && tsc --noEmit",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "build:api": "esbuild src/server/serverless.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.6.0",
    "helmet": "^8.1.0",
    "livekit-client": "^2.11.0",
    "livekit-server-sdk": "^2.11.0",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "sql.js": "^1.15.2",
    "tailwind-merge": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.9"
  }
}
